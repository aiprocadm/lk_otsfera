DATABASE_URL=postgresql://postgres:postgres@db:5432/cabinet
DIRECT_URL=postgresql://postgres:postgres@db:5432/cabinet
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required for auth JWT signing/verification; use a strong random secret (minimum 32 characters).
JWT_SECRET=replace_with_at_least_32_chars
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=anon
SUPABASE_SERVICE_ROLE_KEY=service
SUPABASE_STORAGE_BUCKET=documents

STUDENT_REDIRECT_URL=https://lms.example.com/auth/bridge
STUDENT_REDIRECT_ALLOWED_DOMAINS=lms.example.com

STUDENT_BRIDGE_JWT_SECRET=replace_me
STUDENT_BRIDGE_TTL=600

# Max upload file size in MB, must be a finite number > 0 (recommended range: 1..100).
DOCUMENT_MAX_FILE_SIZE_MB=10

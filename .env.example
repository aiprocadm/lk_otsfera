DATABASE_URL=postgresql://postgres:postgres@db:5432/cabinet
DIRECT_URL=postgresql://postgres:postgres@db:5432/cabinet
# Server-side base URL. Read across the server (notifications, invites,
# reset-password links, and the student-bridge JWT issuer). REQUIRED locally:
# without it /student/redirect throws "STUDENT_BRIDGE_ISSUER (or APP_URL) is not
# configured" and dev emails fall back to the prod default https://lk.otsfera.ru.
APP_URL=http://localhost:3000
# Optional explicit override for the student-bridge JWT issuer claim. Falls back
# to APP_URL when unset. Set in prod to the canonical cabinet origin.
# STUDENT_BRIDGE_ISSUER=https://lk.otsfera.ru
# Required for auth JWT signing/verification; use a strong random secret (minimum 32 characters).
JWT_SECRET=replace_with_at_least_32_chars
# S3-совместимое объектное хранилище (РФ-провайдер: Yandex Object Storage /
# VK Cloud / Selectel). Заменяет Supabase Storage (152-ФЗ — файлы = ПДн → РФ).
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=documents
# 1 для MinIO и провайдеров без virtual-host-style (path-style адресация):
S3_FORCE_PATH_STYLE=1

STUDENT_REDIRECT_URL=https://lms.example.com/auth/bridge
STUDENT_REDIRECT_ALLOWED_DOMAINS=lms.example.com

# Student bridge JWT secret. Minimum 32 characters; if unset, JWT_SECRET is used.
STUDENT_BRIDGE_JWT_SECRET=replace_with_at_least_32_chars
STUDENT_BRIDGE_TTL=600

# Max upload file size in MB, must be a finite number > 0 (recommended range: 1..200, default: 200).
DOCUMENT_MAX_FILE_SIZE_MB=200

# Optional: login brute-force rate limit (per IP). Defaults: 10 attempts / 60s.
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Readiness probe (/api/health) bearer token. 32+ chars recommended.
# When unset, /api/health returns 503 (fail-closed). /api/health/live is always public.
# HEALTH_TOKEN=replace_with_at_least_32_chars

# --- Observability (PR-2 серии укрепления) ---
# Sentry: пустой/незаданный DSN => полный no-op (локально и в тестах не шумит,
# в сеть не ходит). Покрывает server (route-handlers/RSC/webhook), edge
# (middleware) и worker BullMQ. ПДн/секреты вычищаются beforeSend-скраббером.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Структурные логи (pino, JSON): в production по умолчанию; LOG_FORMAT=json|console
# форсирует транспорт, LOG_LEVEL (debug|info|warn|error, default info).
# LOG_LEVEL=info
# LOG_FORMAT=json

# Redis для BullMQ (фоновые задачи, синхронизация с 1С).
REDIS_URL=redis://redis:6379
# Для локального запуска вне Docker:
# REDIS_URL=redis://localhost:6379

# 1С интеграция: fake (default — данные in-memory) | rest | file
ONE_C_ADAPTER=fake
# Режим записи: live (по умолчанию — пишет в БД) | shadow (читает реальную 1С,
# валидирует и логирует намерения в SyncLog, НИЧЕГО не пишет — для безопасного cutover).
# ONE_C_MODE=live
# REST-адаптер (ONE_C_ADAPTER=rest требует обе переменные):
# ONE_C_API_URL=https://1c.example.com
# ONE_C_API_TOKEN=replace_with_token
# Таймаут одного HTTP-запроса к 1С, мс (по умолчанию 15000):
# ONE_C_HTTP_TIMEOUT_MS=15000
# Safety-overlap инкрементального курсора, мин (по умолчанию 5):
# ONE_C_CURSOR_OVERLAP_MINUTES=5

# Feature flags. Most default to enabled; set any to 0/false/off to disable.
# Used by middleware (404), navigation (hide menu item), and route handlers
# (notFoundIfDisabled / requireFeature).
# FEATURE_PARTNER_LEADS=1
# FEATURE_COMMISSION_PDF=1
# FEATURE_COMMISSION_XLSX=1
# FEATURE_PWA_INSTALLER=1
#
# Opt-in flags default to DISABLED — must be set to 1/true/on to enable.
# Used for dark-launch / staged rollout of new cabinets.
# FEATURE_ORGANIZATION_CABINET=0
# FEATURE_MANAGER_CABINET=0
# FEATURE_LEADER_CABINET=0        # кабинет руководителя; включать ТОЛЬКО вместе с FEATURE_MANAGER_CABINET=1
# FEATURE_ENROLLMENT_REQUESTS=0   # T5: «заявки на обучение» (подача 5 ролей + утверждение)
# FEATURE_CHAT=0                  # team-chat partner/org + чат-секция менеджера (комментарии к заказам — вне флага, см. CLAUDE.md §5)
# FEATURE_ROLE_CONSTRUCTOR=0      # G1: конструктор ролей (/leader/roles + /admin/roles)
# FEATURE_SALES_FUNNEL=0          # G2: воронка продаж (/leader/funnel + /manager/funnel)
# FEATURE_INTERNAL_TASKS=0        # G3: внутренние задачи (/manager/tasks + /leader/tasks)
# FEATURE_INBOUND_MESSAGING=0     # PR-A: омниканальный инбокс (/manager/inbox) + ingest из вебхуков (см. блок PR-A ниже)
# FEATURE_TELEPHONY_MANGO=0       # PR-B: телефония Mango (/manager/calls); боевой REST-адаптер — заглушка, в проде держать 0

# Демо-доступ на /login: показывает блок с готовыми логинами/паролями
# всех ролей (autofill формы по клику). НЕ является FEATURE_-флагом —
# читается только страницей входа как server-only env (не NEXT_PUBLIC_*),
# поэтому учётные данные не попадают в клиентский бандл при выключенном флаге.
# По умолчанию ВЫКЛЮЧЕНО. Включать ТОЛЬКО на dev/staging-стендах.
# НИКОГДА не включать в production — это раскрытие учётных данных.
# SHOW_DEMO_LOGINS=on

# Optional ClamAV (Phase 5, Task 2). When unset the scan processor marks
# every file 'clean' and writes a SyncLog warning — safe for dev/CI.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000

# Email pipeline (Phase 5, Task 5). Resend SDK. When EMAIL_ENABLED is not
# 'true' triggerNotificationEmail is a silent no-op. When EMAIL_ENABLED=true
# but RESEND_API_KEY is missing, send() logs a warning and skips.
# EMAIL_ENABLED=true
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=no-reply@otsfera.ru

# ---- Ops alerting (subsystem 1В). Evaluated every 5 min by the worker when
# ---- ENABLE_SYNC_CRON=1. Notifies all role=admin users (in-app + email) + Telegram.
# ALERT_QUEUE_WAITING_MAX=100      # waiting jobs per queue before alerting
# ALERT_DLQ_MAX=0                  # failed jobs per queue before alerting (0 = any)
# ALERT_SYNC_LAG_MAX_HOURS=24      # 1C sync lag before alerting
# ALERT_RENOTIFY_COOLDOWN_HOURS=6  # re-notify cadence while a breach persists
# Telegram channel (optional — skipped if unset):
# ALERT_TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# ALERT_TELEGRAM_CHAT_ID=-1001234567890

# --- Telegram-уведомления пользователям (§18; опционально — фича дремлет, если не задано) ---
# Бот может быть тем же, что и для алертов выше. Username — без @. Webhook ставится через
# setWebhook с secret_token == TELEGRAM_WEBHOOK_SECRET (см. README). Привязка: пользователь
# в кабинете «Настройки» получает deep-link, шлёт /start боту.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_BOT_USERNAME=my_lk_bot
# TELEGRAM_WEBHOOK_SECRET=<случайная-строка-32+>

# --- Трек D: каналы уведомлений Max и WhatsApp (opt-in feature-флаги + креды) ---
# Оба канала за единым интерфейсом NotificationChannel; включаются независимо.
# Флаг + креды обязательны (без флага канал спит даже при заданных кредах).
#
# Max (нативная интеграция по образцу Telegram). Привязка: deep-link + /start webhook
# (POST /api/integrations/max/webhook, секрет-заголовок x-max-webhook-secret).
# FEATURE_MAX_CHANNEL=1
# MAX_BOT_TOKEN=<токен-бота-Max>
# MAX_BOT_USERNAME=my_lk_max_bot
# MAX_API_BASE_URL=https://botapi.max.ru   # опц. override (по умолчанию botapi.max.ru)
# MAX_WEBHOOK_SECRET=<случайная-строка-32+>
#
# WhatsApp через агрегатор (Wazzup-подобный сервис; НЕ прямая интеграция с Meta).
# Номер отправителя подключается в сервисе-агрегаторе; ключ и channelId — из окружения.
# FEATURE_WHATSAPP_CHANNEL=1
# WHATSAPP_AGGREGATOR_BASE_URL=https://api.wazzup24.com   # опц. override
# WHATSAPP_AGGREGATOR_API_KEY=<api-ключ-агрегатора>
# WHATSAPP_AGGREGATOR_CHANNEL_ID=<id-подключённого-канала>
# Входящие WhatsApp (омниканальный инбокс, FEATURE_INBOUND_MESSAGING): секрет
# вебхука агрегатора, заголовок x-wazzup-secret. Без него вебхук отвечает 401
# (fail-closed) — задать при подключении входящих.
# WHATSAPP_WEBHOOK_SECRET=<случайная-строка-32+>

# --- Трек D5: доставка уведомлений через воркер (BullMQ) вместо inline ---
# opt-in; требует REDIS_URL. Без флага/Redis доставка идёт inline (как раньше).
# Идемпотентность по jobId (одно событие → не задваивается в канале).
# FEATURE_NOTIF_QUEUE=1

# --- PR-A: омниканальный инбокс (FEATURE_INBOUND_MESSAGING) ---
# Входящие письма: fake (default — dev no-op) | imap. Боевой IMAP-адаптер пока
# заглушка (бросает 'not wired') — в проде НЕ ставить imap, иначе cron-джоба
# inbound.email.poll уходит в DLQ каждые 2 минуты. Поллинг регистрируется
# только при ENABLE_SYNC_CRON=1.
# INBOUND_EMAIL_ADAPTER=fake
# IMAP_HOST=imap.example.ru
# IMAP_PORT=993
# IMAP_USER=inbox@example.ru
# IMAP_PASSWORD=<пароль-ящика>
# IMAP_TLS=1                       # default: включён; 0/false/off — выключить
# FAKE_INBOUND_EMAIL=              # dev-ноб fake-адаптера (JSON с письмами)

# --- PR-B: телефония Mango Office (FEATURE_TELEPHONY_MANGO) ---
# Вебхук /api/integrations/mango/webhook: подпись sha256(apiKey+json+salt) +
# IP-allowlist — ОБА обязательны, провал любого → 401 (fail-closed).
# MANGO_API_KEY=<ключ-API-Mango>
# MANGO_API_SALT=<соль-подписи-Mango>
# MANGO_ALLOWED_IPS=81.88.80.132,81.88.80.133,81.88.82.36
# Адаптер записей/статистики: fake (default) | rest. REST — намеренная заглушка
# (бросает 'not wired'): до боевой реализации rest НЕ включать.
# MANGO_ADAPTER=fake
# Пауза между попытками поллинга готовности stats-отчёта в backfill, мс (default 3000):
# MANGO_STATS_POLL_DELAY_MS=3000
# MANGO_VPBX_BASE_URL=https://app.mango-office.ru/vpbx
# FAKE_MANGO_STATS=                # dev-нобы fake-адаптера
# FAKE_MANGO_RECORDING=

# --- Student bridge: серверный обмен одноразового кода на bridge-JWT ---
# Секрет, которым внешняя СДО аутентифицируется на /api/student/bridge/token.
# Без него обмен отвечает 403 (fail-closed) — мост в СДО не заработает.
# STUDENT_BRIDGE_SHARED_SECRET=<случайная-строка-32+>
# TTL одноразового кода, сек (default 60):
# STUDENT_BRIDGE_CODE_TTL_SEC=60
# Rate-limit обмена кода (default 10 запросов / 60000 мс на IP):
# STUDENT_BRIDGE_RATE_LIMIT_MAX=10
# STUDENT_BRIDGE_RATE_LIMIT_WINDOW_MS=60000
# (STUDENT_PORTAL_URL / STUDENT_PORTAL_ALLOWED_HOSTS — deprecated-легаси,
#  используйте STUDENT_REDIRECT_URL / STUDENT_REDIRECT_ALLOWED_DOMAINS выше.)

# --- Прочие серверные ручки ---
# Воркер: регистрация cron-расписаний (1С sync, комиссии, алерты, сроки
# удостоверений, поллинг инбокса). В prod-контуре воркера — обязательно 1;
# без него воркер в hot-standby (слушает очереди, cron не тикает).
# ENABLE_SYNC_CRON=1
# Грейс graceful shutdown воркера, мс (default 25000 — меньше 30с grace Docker/K8s;
# по истечении процесс выходит принудительно с кодом 1 и error-логом):
# WORKER_SHUTDOWN_TIMEOUT_MS=25000
# TTL invite-токенов, дней (default 7):
# INVITE_TOKEN_TTL_DAYS=7
# TTL reset-токенов, часов (default 2 — окно перехвата ссылки сброса узкое):
# RESET_TOKEN_TTL_HOURS=2
# TTL presigned-ссылок скачивания документов, сек (default 120):
# DOCUMENT_SIGNED_URL_TTL_SEC=120
# 1С pending-докачка документов: макс. попыток (default 50) и возраст, дней (default 7):
# ONE_C_PENDING_MAX_ATTEMPTS=50
# ONE_C_PENDING_MAX_AGE_DAYS=7
# Размер батча scan-backfill свипа (default 500):
# BACKFILL_BATCH=500

# --- Mock 1С REST server (dev/test only — `npm run mock:1c`) ---
# Point the worker at the mock for a local shadow rehearsal:
#   ONE_C_ADAPTER=rest
#   ONE_C_API_URL=http://localhost:4010
#   ONE_C_API_TOKEN=mock-token
#   ONE_C_MODE=shadow
MOCK1C_PORT=4010
MOCK1C_TOKEN=mock-token
# Scenario knobs (default = happy path):
MOCK1C_ENVELOPE=array            # array | items | other (Q1)
MOCK1C_STATUS_DIALECT=app        # app | russian       (Q10 → quarantine)
MOCK1C_DATETIME=utc-z            # utc-z | no-offset   (Q7 → silent skew)
MOCK1C_PAGE_SIZE=0               # >0 serves only page 1 (Q6 → first-page-only)
MOCK1C_MALFORMED_RATE=0          # >0 appends a schema-breaking record
MOCK1C_DUPLICATES=0              # 1 repeats the first record
MOCK1C_FAIL_MODE=none            # none | transient (503+Retry-After) | permanent (500)
MOCK1C_LATENCY_MS=0              # >ONE_C_HTTP_TIMEOUT_MS triggers a client timeout
MOCK1C_PUSH_FAIL_RATE=0          # 0..1 chance POST /api/leads returns 500

# --- Bootstrap первого администратора (scripts/create-admin.ts, `npm run db:create-admin`) ---
# Разовый идемпотентный скрипт для не-демо БД (чистый локальный стенд / свежий прод).
# Вход ТОЛЬКО через env (не CLI-аргументы) — пароль не попадает в историю shell / ps.
# НИКОГДА не коммитить реальные значения.
# ADMIN_EMAIL=admin@example.ru       # обязателен
# ADMIN_PASSWORD=replace_me_min8     # обязателен, ≥ 8 символов
# ADMIN_NAME=Администратор           # необязателен (дефолт)
# ADMIN_COMPANY=Промтехносфера       # необязателен (дефолт)

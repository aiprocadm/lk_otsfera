# ============================================================================
# lk-otsfera — переменные окружения
#
# Файл синхронизирован с кодом механически (У-134, стражи
# config.env-registry.guardrail и config.env-example.guardrail):
# - каждая переменная, которую читает код, описана здесь;
# - мёртвые строки не живут — страж падает на переменной, которую код
#   больше не читает;
# - пометка «задаётся в интерфейсе» означает: настройка переехала в БД
#   (таблица IntegrationSetting) и правится из кабинета администратора;
#   env остаётся ЗАПАСНЫМ вариантом с приоритетом «база → env → умолчание».
#   Значение в вашем .env перестаёт действовать, как только настройку
#   сохранили в интерфейсе.
# ============================================================================

# ---------------------------------------------------------------------------
# Инфраструктура: база, очереди, ключи процесса (только env)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@db:5432/cabinet
# Прямое подключение мимо пула — нужно prisma migrate:
DIRECT_URL=postgresql://postgres:postgres@db:5432/cabinet
# Redis для BullMQ (фоновые задачи, синхронизация с 1С).
# Для локального запуска вне Docker: redis://localhost:6379
REDIS_URL=redis://redis:6379
# Подпись сессионных JWT; сильный случайный секрет минимум 32 символа —
# короче, и middleware отправляет всех на /login.
JWT_SECRET=replace_with_at_least_32_chars
# Мастер-ключ шифрования секретов интеграций перед записью в БД (AES-256-GCM).
# 32 байта hex (64 симв.) ЛИБО парольная фраза ≥16 символов. В production
# ОБЯЗАТЕЛЕН (У-132) — без него сервер не поднимается; локально можно не
# задавать — форма интеграций покажет баннер вместо сохранения секретов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APP_ENCRYPTION_KEY=replace_me_64_hex_chars
# Базовый адрес кабинета: ссылки в письмах, приглашения, issuer student-bridge.
# Без него /student/redirect падает, а dev-письма ведут на прод-домен.
APP_URL=http://localhost:3000
# Bearer readiness-пробы /api/health (32+ симв.); не задан — проба отвечает
# 503 fail-closed. /api/health/live всегда публичен.
# HEALTH_TOKEN=replace_with_at_least_32_chars

# ---------------------------------------------------------------------------
# Объектное хранилище (S3-совместимое, РФ-провайдер; файлы = ПДн → 152-ФЗ)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=documents
# 1 для MinIO и провайдеров без virtual-host-style адресации:
S3_FORCE_PATH_STYLE=1

# ---------------------------------------------------------------------------
# Наблюдаемость
# ---------------------------------------------------------------------------
# Sentry: пустой/незаданный DSN = полный no-op (локально не шумит). Покрывает
# server, edge (middleware) и worker; ПДн вычищаются скраббером.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Структурные логи (pino): LOG_FORMAT=json|console форсирует транспорт,
# LOG_LEVEL — debug|info|warn|error (default info).
# LOG_LEVEL=info
# LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Антивирус ClamAV (не задан — скан помечает файлы clean с предупреждением
# в SyncLog; безопасно для dev/CI)
# ---------------------------------------------------------------------------
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Документы
# ---------------------------------------------------------------------------
# Предел загрузки файла, МБ (конечное число > 0; рекомендовано 1..200):
DOCUMENT_MAX_FILE_SIZE_MB=200
# TTL presigned-ссылок скачивания, сек (default 120):
# DOCUMENT_SIGNED_URL_TTL_SEC=120

# ---------------------------------------------------------------------------
# Мост в СДО (student bridge)
# ---------------------------------------------------------------------------
STUDENT_REDIRECT_URL=https://lms.example.com/auth/bridge
STUDENT_REDIRECT_ALLOWED_DOMAINS=lms.example.com
# Подпись bridge-JWT, минимум 32 символа; не задан — используется JWT_SECRET.
STUDENT_BRIDGE_JWT_SECRET=replace_with_at_least_32_chars
STUDENT_BRIDGE_TTL=600
# Issuer-claim bridge-JWT; не задан — берётся APP_URL. В проде — канонический
# origin кабинета.
# STUDENT_BRIDGE_ISSUER=https://lk.otsfera.ru
# Секрет, которым внешняя СДО аутентифицируется на /api/student/bridge/token;
# не задан — обмен отвечает 403 fail-closed.
# STUDENT_BRIDGE_SHARED_SECRET=<случайная-строка-32+>
# TTL одноразового кода, сек (default 60):
# STUDENT_BRIDGE_CODE_TTL_SEC=60
# Rate-limit обмена кода (default 10 запросов / 60000 мс на IP):
# STUDENT_BRIDGE_RATE_LIMIT_MAX=10
# STUDENT_BRIDGE_RATE_LIMIT_WINDOW_MS=60000
# Легаси-алиасы (deprecated): читаются как запасные для двух переменных выше —
# в новых установках используйте STUDENT_REDIRECT_*.
# STUDENT_PORTAL_URL=
# STUDENT_PORTAL_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Воркер
# ---------------------------------------------------------------------------
# Регистрация cron-задач (1С sync, комиссии, алерты, сроки удостоверений,
# поллинг инбокса). В prod-контуре воркера обязательно 1; без него воркер в
# hot-standby: слушает очереди, cron не тикает.
# ENABLE_SYNC_CRON=1
# Грейс graceful shutdown, мс (default 25000 — меньше 30с grace Docker/K8s):
# WORKER_SHUTDOWN_TIMEOUT_MS=25000
# Файл heartbeat для liveness-пробы воркера (default /tmp/worker-heartbeat):
# WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat
# Размер батча scan-backfill свипа (default 500):
# BACKFILL_BATCH=500

# ---------------------------------------------------------------------------
# Среда — выставляет платформа (Node/Next), руками не задавать
# ---------------------------------------------------------------------------
# NODE_ENV=production
# NEXT_RUNTIME=nodejs

# ---------------------------------------------------------------------------
# Демо и dev-нобы (в проде не задавать)
# ---------------------------------------------------------------------------
# Блок демо-логинов на /login (autofill по клику). Server-only env, в бандл не
# попадает. ТОЛЬКО dev/staging; в production НИКОГДА — раскрытие учёток.
# SHOW_DEMO_LOGINS=on
# Сценарные нобы fake-адаптеров:
# FAKE_INBOUND_EMAIL=              # JSON с письмами для fake-инбокса
# FAKE_MANGO_STATS=                # fake-статистика Mango
# FAKE_MANGO_RECORDING=            # fake-записи разговоров Mango
# FAKE_ONEC_FAILURE_RATE=0         # доля отказов fake-1С (0..1)
# FAKE_ONEC_LATENCY_MS=0           # задержка ответа fake-1С
# FAKE_ONEC_MALFORMED_RATE=0       # доля битых записей fake-1С (0..1)

# ---------------------------------------------------------------------------
# E2E (playwright auth.setup) — учётки сидированной базы для прогона
# ---------------------------------------------------------------------------
# E2E_ADMIN_EMAIL=admin@demo.local
# E2E_ADMIN_PASSWORD=Password123!
# E2E_LEADER_EMAIL=leader@demo.local
# E2E_LEADER_PASSWORD=Password123!
# E2E_MANAGER_EMAIL=manager@demo.local
# E2E_MANAGER_PASSWORD=Password123!
# E2E_ORG_EMAIL=org@demo.local
# E2E_ORG_PASSWORD=Password123!
# E2E_PARTNER_EMAIL=partner@demo.local
# E2E_PARTNER_PASSWORD=Password123!
# E2E_STUDENT_EMAIL=student@demo.local
# E2E_STUDENT_PASSWORD=Password123!

# ---------------------------------------------------------------------------
# Route-флаги (edge): читаются middleware, у которого нет доступа к БД, —
# поэтому ТОЛЬКО env, из интерфейса они read-only. Opt-in: включать = 1/true/on.
# ---------------------------------------------------------------------------
# FEATURE_ORGANIZATION_CABINET=0
# FEATURE_MANAGER_CABINET=0
# FEATURE_LEADER_CABINET=0        # включать ТОЛЬКО вместе с FEATURE_MANAGER_CABINET=1
# FEATURE_CHAT=0                  # team-chat partner/org + чат-секция менеджера (комментарии к заказам — вне флага)
# FEATURE_ENROLLMENT_REQUESTS=0   # заявки на обучение (подача 5 ролей + утверждение)
# FEATURE_ROLE_CONSTRUCTOR=0      # конструктор ролей (/leader/roles + /admin/roles)
# FEATURE_SALES_FUNNEL=0          # воронка продаж (/leader/funnel + /manager/funnel)
# FEATURE_LEADER_ANALYTICS=0      # аналитика руководителя (/leader/analytics)
# FEATURE_INTERNAL_TASKS=0        # внутренние задачи (/manager/tasks + /leader/tasks)
# FEATURE_INBOUND_MESSAGING=0     # омниканальный инбокс (/manager/inbox) + ingest вебхуков
# FEATURE_CLIENT_REQUESTS=0       # обращения клиентов (/…/requests)
# FEATURE_CERTIFICATES_REGISTRY=0 # реестр удостоверений (/…/certificates)
# FEATURE_DEALS_PIPELINE=0        # воронка сделок
# FEATURE_INTAKE_INBOX=0          # очередь «Входящие в работу»

# ---------------------------------------------------------------------------
# Поведенческие флаги: значение задаётся в интерфейсе
# (Настройки → Безопасность и система → Флаги функциональности) и хранится в
# БД; env — запасной вариант, пока флаг не сохранили из UI. Opt-out (вкл. по
# умолчанию): commission_pdf, commission_xlsx, pwa_installer, pii_access_log,
# document_generation.
# ---------------------------------------------------------------------------
# FEATURE_COMMISSION_PDF=1
# FEATURE_COMMISSION_XLSX=1
# FEATURE_PWA_INSTALLER=1
# FEATURE_PII_ACCESS_LOG=1        # журнал доступа к ПДн (§25.7); 0 — только аварийный kill-switch
# FEATURE_MAX_CHANNEL=0           # канал уведомлений Max (креды ниже)
# FEATURE_WHATSAPP_CHANNEL=0      # канал уведомлений WhatsApp (креды ниже)
# FEATURE_NOTIF_QUEUE=0           # доставка уведомлений через воркер (BullMQ) вместо inline
# FEATURE_TELEPHONY_MANGO=0       # телефония Mango (/manager/calls); Р-24: включается из UI
# FEATURE_STAFF_2FA=0             # email-код при входе admin/manager/leader; нужна доставка писем
# FEATURE_STAFF_CHAT=0            # внутренний чат сотрудников
# FEATURE_STAFF_CALENDAR=0        # календарь сотрудников
# FEATURE_GLOBAL_SEARCH=0         # глобальный поиск
# FEATURE_DOCUMENT_GENERATION=1   # выпуск документов по заказу (opt-out: включён по умолчанию)
# FEATURE_CABINET_QUESTIONS=0     # вопросы из кабинетов
# FEATURE_CONTACTS=0              # справочник контактов (route-точки добавятся своим PR)
# FEATURE_SETTINGS_HUB=1          # хаб «Настройки» + редиректы со старых адресов (снимается после приёмки)

# ===========================================================================
# ДАЛЬШЕ — НАСТРОЙКИ, ПЕРЕЕХАВШИЕ В ИНТЕРФЕЙС (этап 4 ТЗ, У-122).
# Каждая задаётся в интерфейсе и хранится в БД; env — запасной вариант на
# переходный период. Раздел указан в шапке блока.
# ===========================================================================

# --- 1С: задаётся в интерфейсе — Настройки → Интеграции → Обмен с 1С -------
# Адаптер: fake (default, in-memory) | rest.
# ONE_C_ADAPTER=fake
# ONE_C_API_URL=https://1c.example.com
# ONE_C_API_TOKEN=replace_with_token
# ONE_C_HEALTH_PATH=health
# Режим записи: live (пишет в БД) | shadow (читает 1С, пишет только SyncLog):
# ONE_C_MODE=live
# ONE_C_HTTP_TIMEOUT_MS=15000
# ONE_C_CURSOR_OVERLAP_MINUTES=5
# Компания по умолчанию для сетевого синка (в UI — выбор из списка):
# ONE_C_COMPANY_ID=
# Pending-докачка документов: макс. попыток и возраст, дней:
# ONE_C_PENDING_MAX_ATTEMPTS=50
# ONE_C_PENDING_MAX_AGE_DAYS=7

# --- DaData: задаётся в интерфейсе — Настройки → Интеграции ----------------
# Подсказки/автозаполнение реквизитов по ИНН; ключ на клиент не передаётся.
# DADATA_ENABLED=false
# DADATA_API_KEY=replace_with_dadata_api_key

# --- Почта (Resend): задаётся в интерфейсе — Настройки → Интеграции --------
# EMAIL_ENABLED != true — отправка молча выключена.
# EMAIL_ENABLED=true
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=no-reply@otsfera.ru

# --- Telegram-бот: задаётся в интерфейсе — Настройки → Интеграции ----------
# Бот уведомлений пользователям; привязка через deep-link + /start.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_BOT_USERNAME=my_lk_bot
# TELEGRAM_WEBHOOK_SECRET=<случайная-строка-32+>

# --- Max-бот: задаётся в интерфейсе — Настройки → Интеграции ---------------
# MAX_BOT_TOKEN=<токен-бота-Max>
# MAX_BOT_USERNAME=my_lk_max_bot
# MAX_API_BASE_URL=https://botapi.max.ru
# MAX_WEBHOOK_SECRET=<случайная-строка-32+>

# --- WhatsApp (агрегатор): задаётся в интерфейсе — Настройки → Интеграции --
# WHATSAPP_AGGREGATOR_BASE_URL=https://api.wazzup24.com
# WHATSAPP_AGGREGATOR_API_KEY=<api-ключ-агрегатора>
# WHATSAPP_AGGREGATOR_CHANNEL_ID=<id-подключённого-канала>
# WHATSAPP_WEBHOOK_SECRET=<случайная-строка-32+>

# --- Входящая почта (IMAP): задаётся в интерфейсе — Настройки → Интеграции -
# INBOUND_EMAIL_ADAPTER=fake
# IMAP_HOST=imap.example.ru
# IMAP_PORT=993
# IMAP_USER=inbox@example.ru
# IMAP_PASSWORD=<пароль-ящика>
# IMAP_TLS=1

# --- Телефония Mango: задаётся в интерфейсе — Настройки → Интеграции -------
# Вебхук: подпись sha256(apiKey+json+salt) + IP-allowlist, оба обязательны.
# MANGO_API_KEY=<ключ-API-Mango>
# MANGO_API_SALT=<соль-подписи-Mango>
# MANGO_ALLOWED_IPS=81.88.80.132,81.88.80.133,81.88.82.36
# MANGO_ADAPTER=fake
# MANGO_STATS_POLL_DELAY_MS=3000
# MANGO_VPBX_BASE_URL=https://app.mango-office.ru/vpbx

# --- Ops-оповещения: задаётся в интерфейсе — Настройки → Безопасность и
# --- система → Здоровье системы → Оповещения --------------------------------
# ALERT_QUEUE_WAITING_MAX=100
# ALERT_DLQ_MAX=0
# ALERT_ONEC_DEADLETTER_MAX=0
# ALERT_SYNC_LAG_MAX_HOURS=24
# ALERT_RENOTIFY_COOLDOWN_HOURS=6
# ALERT_TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# ALERT_TELEGRAM_CHAT_ID=-1001234567890

# --- Правила входа: задаётся в интерфейсе — Настройки → Безопасность и
# --- система → Политики входа -----------------------------------------------
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=60000
# INVITE_TOKEN_TTL_DAYS=7
# RESET_TOKEN_TTL_HOURS=2

# ===========================================================================
# Инструменты вне приложения (скрипты, mock-сервер) — код кабинета не читает
# ===========================================================================

# --- Mock 1С REST server (dev/test — `npm run mock:1c`) --------------------
MOCK1C_PORT=4010
MOCK1C_TOKEN=mock-token
MOCK1C_ENVELOPE=array            # array | items | other
MOCK1C_STATUS_DIALECT=app        # app | russian (→ карантин)
MOCK1C_DATETIME=utc-z            # utc-z | no-offset
MOCK1C_PAGE_SIZE=0               # >0 отдаёт только первую страницу
MOCK1C_MALFORMED_RATE=0          # >0 подмешивает битую запись
MOCK1C_DUPLICATES=0              # 1 повторяет первую запись
MOCK1C_FAIL_MODE=none            # none | transient | permanent
MOCK1C_LATENCY_MS=0              # > таймаута — клиентский таймаут
MOCK1C_PUSH_FAIL_RATE=0          # 0..1 вероятность 500 на POST /api/leads

# --- Production-развёртывание (docker-compose.prod.yml) --------------------
# Домен, на который Caddy выпускает TLS-сертификат (см. .env.production.example):
# APP_DOMAIN=lk.example.ru

# --- Bootstrap первого администратора (`npm run db:create-admin`) ----------
# Только env (не CLI) — пароль не светится в истории shell / ps.
# ADMIN_EMAIL=admin@example.ru
# ADMIN_PASSWORD=replace_me_min8
# ADMIN_NAME=Администратор
# ADMIN_COMPANY=Промтехносфера

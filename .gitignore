.env.production

# Local-only assistant/session state — never commit
.claude/
.remember/
.pr-body.md

# Vitest coverage output (regenerated locally, never committed).
# Точечные прогоны кладут отчёт в свой каталог (`--coverage.reportsDirectory`),
# иначе параллельные прогони дерутся за `coverage/.tmp`.
coverage/
coverage-*/
.tmp-cov/
coverage-full-run.log
coverage-*.log

# Playwright runtime output (kept locally for diffs, never committed).
# Baseline snapshots under src/e2e/snapshots/*-snapshots/ are committed.
playwright-report/
test-results/

# Brainstorming visual companion sessions
.superpowers/

# Логи любого происхождения (`У-259`, дефект `Д-41`).
#
# Раньше здесь лежал список имён поимённо, и он отставал от жизни: под git
# приехали `seed.err.log`, `seed.out.log`, `worker.err.log`, `worker.log` —
# просто потому, что их имён в списке не оказалось. Общее правило снимает
# сам класс ошибки; страж `repo.no-log-files.guardrail` держит его честным.
*.log
.playwright-mcp/

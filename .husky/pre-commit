# L1: pre-commit — fast guards. Target ~5-10 sec total.
#
# Runs:
#   1. lint-staged: ESLint on staged .ts/.tsx files only (sub-second)
#   2. tsc --noEmit: project-wide typecheck (incremental, ~3-5 sec)
#   3. vitest --changed --mode=unit: only tests touched by staged files (1-3 sec)
#
# Integration tests (live Postgres) are NEVER run here — they're guarded
# by `--mode=unit`. Run `npm run test:integration` manually before PR/release.
#
# To bypass in an emergency (use sparingly): git commit --no-verify

npx lint-staged
npm run typecheck
npm run test:changed

model ThreadReadState {
  id         String      @id @default(cuid())
  threadId   String
  thread     OrderThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

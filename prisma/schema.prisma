generator client {
  provider      = "prisma-client-js"
  // Alpine-рантайм (node:*-alpine) несёт OpenSSL 3.x; без явного musl-openssl-3.0.x
  // таргета Prisma в минимальном образе не детектит openssl и откатывается на
  // движок под openssl-1.1.x (нужен libssl.so.1.1, которого в Alpine 3.x нет).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  manager
  partner
  organization
  student
}

// Трек G1: уровень охвата кастомного профиля доступа по типу объекта.
// own = только свои (managerId==sub), assigned = закреплённые (managedOrgIds),
// all = все в рамках компании (C8-пол). Дефолт колонок AccessProfile = all
// применяется только к ЯВНО созданным профилям; существующие менеджеры без
// профиля сохраняют legacy teamMode-поведение.
enum ScopeLevel {
  own
  assigned
  all
}

enum OrderStatus {
  new
  in_progress
  waiting_client
  completed
}

enum ExecutionStatus {
  pending
  in_progress
  completed
  cancelled
  on_hold
}

enum FinancialStatus {
  not_billed
  billed
  partially_paid
  paid
  refunded
}

/// §5/§7 ТЗ: универсальная заявка — тип услуги как параметр заявки, а не отдельная
/// сущность. Расширяемо (Postgres ALTER TYPE ADD VALUE). Дефолт `training`, чтобы
/// существующие заявки (все — обучение) не сломались; учебная специфика (удостоверения)
/// применяется только для `training` (см. lib/orders/completion.ts).
enum ServiceType {
  training
  document_development
}

enum DocumentType {
  contract
  extra_agreement
  invoice
  act
  waybill
  certificate
  report
  commission_statement
  other
}

enum DocumentDirection {
  incoming
  outgoing
}

enum CounterpartyType {
  organization
  partner
}

enum GenerationSource {
  user
  system
}

enum NotificationType {
  lead_status_changed
  order_status_changed
  payment_received
  document_uploaded
  commission_statement_ready
  mention_in_comment
  partner_assignment_changed
  sync_error
}

enum LeadStatus {
  new
  in_review
  qualified
  promoted_to_order
  // Этап 6 (ФТ-4.4, решение §9-1): лид передан в сделку (терминальный).
  promoted_to_deal
  rejected
}

// Этап 5 (Модуль 1): происхождение лида. partner_legacy — созданные партнёрами
// до запрета ФТ-1.5; client_request — из триажа заявки; manual — сотрудником;
// website — задел (решение §10-4 ТЗ: вебхука пока нет).
enum LeadSource {
  partner_legacy
  client_request
  manual
  website
}

// Этап 5 (Модуль 1): заявка клиента общего вида (ClientRequest).
// Этап 6 (Модуль 4): статус-якоря сделок; словарь стадий DealStage поверх них.
enum DealStatus {
  open
  won
  lost
}

enum ClientRequestSource {
  partner_cabinet
  organization_cabinet
  website
}

// Русские подписи: «подана → в работе → принята/отклонена».
enum ClientRequestStatus {
  submitted
  in_triage
  converted
  rejected
}

enum CommissionStatementStatus {
  draft
  approved
  paid
  superseded
}

enum ThreadSide {
  org
  partner
}

// Трек G3 (§21): enum-якорь колонок канбана задач. Дефолтные колонки
// (DEFAULT_TASK_COLUMNS) привязаны к этим значениям; кастомные TaskColumn несут
// statusAnchor. Task.status re-derive колонку при columnId=null (как Lead.status).
enum TaskStatus {
  todo
  in_progress
  review
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum ContactChannelType {
  phone
  email
  telegram
  whatsapp
  max
}

enum StaffConversationKind {
  dm
  general
}

model User {
  id                           String                    @id @default(cuid())
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  email                        String                    @unique
  passwordHash                 String?
  name                         String
  isActive                     Boolean                   @default(true)
  role                         Role                      @default(organization)
  // Этап 4 (ФТ-10.4): одноразовый welcome-блок клиентских дашбордов; null = ещё не скрыт.
  welcomeSeenAt                DateTime?
  managerRole                  String? // null = regular manager, 'leader' = руководитель
  companyId                    String?
  company                      Company?                  @relation(fields: [companyId], references: [id])
  // Трек G1: кастомный профиль доступа (nullable; null = legacy teamMode-поведение).
  accessProfileId              String?
  accessProfile                AccessProfile?            @relation(fields: [accessProfileId], references: [id])
  partnerId                    String?
  partner                      Partner?                  @relation(fields: [partnerId], references: [id])
  organizationId               String?
  organization                 Organization?             @relation("UserOrganization", fields: [organizationId], references: [id])
  organizationUsers            OrganizationUser[]
  managedOrganizations         OrganizationManager[]     @relation("UserManagedOrgs")
  externalStudentId            String?
  managedOrders                Order[]                   @relation("OrderManager")
  comments                     Comment[]
  documents                    Document[]
  auditLogs                    AuditLog[]
  piiAccessEvents              PiiAccessEvent[]
  notifications                Notification[]
  studentBridgeGrants          StudentBridgeGrant[]
  partnerMemberships           PartnerUser[]             @relation("PartnerMembership")
  leadsAuthored                Lead[]                    @relation("LeadAuthor")
  leadsManaged                 Lead[]                    @relation("LeadManager")
  dealsManaged                 Deal[]                    @relation("DealManager")
  leadAttachmentsAuthored      LeadAttachment[]          @relation("LeadAttachmentAuthor")
  clientRequestsSubmitted      ClientRequest[]           @relation("ClientRequestSubmitter")
  clientRequestsTriaged        ClientRequest[]           @relation("ClientRequestTriager")
  clientRequestAttachments     ClientRequestAttachment[] @relation("ClientRequestAttachmentAuthor")
  commissionStatementsAuthored CommissionStatement[]     @relation("CommissionAuthor")
  savedViews                   SavedView[]               @relation("SavedViewOwner")
  passwordResetTokens          PasswordResetToken[]
  twoFactorChallenge           TwoFactorChallenge?
  twoFactorBackupCodes         TwoFactorBackupCode[]
  authoredMessages             Message[]                 @relation("MessageAuthor")
  threadReadStates             ThreadReadState[]
  documentViewMarks            DocumentViewMark[]
  enrollmentsSubmitted         EnrollmentRequest[]       @relation("EnrollmentSubmitter")
  enrollmentsReviewed          EnrollmentRequest[]       @relation("EnrollmentReviewer")
  paymentsEntered              Payment[]                 @relation("PaymentEnteredBy")
  paymentImportBatches         PaymentImportBatch[]      @relation("PaymentImportBatchBy")
  telegramChatId               String?                   @unique // null = Telegram не привязан (§18)
  telegramLinkCode             String? // одноразовый код привязки (deep-link start param)
  telegramLinkCodeExpiresAt    DateTime?
  // Трек D: привязки каналов Max/WhatsApp (зеркало telegram-полей) +
  // пользовательские настройки каналов. Семантика opt-in: канал включён ⟺
  // привязка есть И notificationChannels[key] !== false (email всегда включён,
  // в Json не хранится). null/мусор в Json → дефолты (см. parseChannelPrefs).
  maxChatId                    String?                   @unique // null = Max не привязан
  maxLinkCode                  String? // одноразовый код привязки Max (deep-link)
  maxLinkCodeExpiresAt         DateTime?
  whatsappPhone                String?                   @unique // E.164; адресация в агрегаторе по номеру
  notificationChannels         Json? // { telegram?: bool, max?: bool, whatsapp?: bool }
  tasksCreated                 Task[]                    @relation("TaskCreatedBy")
  taskAssignments              TaskAssignee[]            @relation("TaskAssignee")
  inboundMessages              InboundMessage[]          @relation("UserInbound")
  calls                        Call[]                    @relation("UserCalls")
  callsInitiated               Call[]                    @relation("CallInitiator")
  dealNotesAuthored            DealNote[]                @relation("DealNoteAuthor")
  internalPhone                String?
  contact                      Contact?                  @relation("UserContact")
  contactsCreated              Contact[]                 @relation("ContactCreatedBy")
  salesTargets                 SalesTarget[]             @relation("SalesTargetManager")
  staffChatParticipations      StaffParticipant[]        @relation("StaffChatParticipant")
  staffMessagesAuthored        StaffMessage[]            @relation("StaffMessageAuthor")
  staffReadStates              StaffMessageRead[]        @relation("StaffChatReadState")
  staffReactions               StaffReaction[]           @relation("StaffReactionAuthor")
  calendarEventsCreated        CalendarEvent[]           @relation("CalendarEventCreatedBy")
  calendarAttendances          CalendarEventAttendee[]   @relation("CalendarEventAttendee")
}

model PartnerUser {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  partnerId      String
  partner        Partner  @relation(fields: [partnerId], references: [id])
  userId         String
  user           User     @relation("PartnerMembership", fields: [userId], references: [id])
  roleInPartner  String   @default("manager")
  assignedOrgIds String[]
  isActive       Boolean  @default(true)

  @@unique([partnerId, userId])
  @@index([partnerId, isActive])
  @@index([userId])
}

model Lead {
  id                 String           @id @default(cuid())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  // Этап 5: nullable — лид из заявки организации/ручной может не иметь партнёра.
  partnerId          String?
  partner            Partner?         @relation(fields: [partnerId], references: [id])
  // Этап 5: происхождение лида; существующие лиды бэкфиллятся partner_legacy.
  source             LeadSource       @default(partner_legacy)
  sourceRequestId    String?          @unique
  sourceRequest      ClientRequest?   @relation("LeadFromRequest", fields: [sourceRequestId], references: [id])
  createdByUserId    String
  createdByUser      User             @relation("LeadAuthor", fields: [createdByUserId], references: [id])
  organizationId     String?
  organization       Organization?    @relation(fields: [organizationId], references: [id])
  clientCompanyName  String
  clientInn          String?
  clientContactName  String
  clientContactPhone String?
  clientContactEmail String?
  subject            String
  estimatedAmount    Decimal?         @db.Decimal(14, 2)
  productType        String[]
  status             LeadStatus       @default(new)
  // Трек G2: тонкая стадия воронки (словарь FunnelStage) поверх якоря status.
  // null = дефолтная стадия для текущего status-якоря. onDelete: SetNull.
  funnelStageId      String?
  funnelStage        FunnelStage?     @relation("LeadFunnelStage", fields: [funnelStageId], references: [id], onDelete: SetNull)
  assignedManagerId  String?
  assignedManager    User?            @relation("LeadManager", fields: [assignedManagerId], references: [id])
  promotedOrderId    String?          @unique
  // Этап 6 (ФТ-4.4, PR-2): лид, переданный в сделку.
  promotedDealId     String?          @unique
  promotedDeal       Deal?            @relation("DealFromLead")
  promotedOrder      Order?           @relation("LeadPromoted", fields: [promotedOrderId], references: [id])
  rejectedReason     String?
  notes              String?
  externalIdInOneC   String?
  pushedToOneCAt     DateTime?
  attachments        LeadAttachment[]

  @@index([partnerId, status])
  @@index([assignedManagerId])
  @@index([createdAt])
}

// Этап 5 (Модуль 1, ФТ-1.1): заявка клиента общего вида. Путь:
// подача (partner/organization) → триаж сотрудником → лид (converted) или отказ.
model ClientRequest {
  id                String                    @id @default(cuid())
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  source            ClientRequestSource
  submittedByUserId String
  submittedByUser   User                      @relation("ClientRequestSubmitter", fields: [submittedByUserId], references: [id])
  partnerId         String?
  partner           Partner?                  @relation(fields: [partnerId], references: [id])
  organizationId    String?
  organization      Organization?             @relation(fields: [organizationId], references: [id])
  companyName       String
  // ИНН со слов клиента; на клиентской стороне на дубли НЕ проверяется (ФТ-13.4).
  inn               String?
  contactName       String
  contactPhone      String?
  contactEmail      String?
  subject           String
  body              String?
  status            ClientRequestStatus       @default(submitted)
  triagedByUserId   String?
  triagedByUser     User?                     @relation("ClientRequestTriager", fields: [triagedByUserId], references: [id])
  triagedAt         DateTime?
  rejectedReason    String?
  convertedLead     Lead?                     @relation("LeadFromRequest")
  attachments       ClientRequestAttachment[]

  @@index([status])
  @@index([partnerId])
  @@index([organizationId])
  @@index([submittedByUserId])
  @@index([createdAt])
}

model ClientRequestAttachment {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  requestId       String
  request         ClientRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser   User?         @relation("ClientRequestAttachmentAuthor", fields: [createdByUserId], references: [id])
  name            String
  path            String
  mimeType        String
  size            Int
  scanStatus      String        @default("pending")
  scanReason      String?
  scannedAt       DateTime?

  @@index([requestId])
  @@index([scanStatus])
}

model LeadAttachment {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id])
  createdByUserId String?
  createdByUser   User?     @relation("LeadAttachmentAuthor", fields: [createdByUserId], references: [id])
  name            String
  path            String
  mimeType        String
  size            Int
  scanStatus      String    @default("pending")
  scanReason      String?
  scannedAt       DateTime?

  @@index([leadId])
  @@index([createdByUserId])
  @@index([scanStatus])
}

model CommissionStatement {
  id                    String                    @id @default(cuid())
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  partnerId             String
  partner               Partner                   @relation(fields: [partnerId], references: [id])
  periodFrom            DateTime
  periodTo              DateTime
  calculatedAt          DateTime                  @default(now())
  calculatedByUserId    String?
  calculatedByUser      User?                     @relation("CommissionAuthor", fields: [calculatedByUserId], references: [id])
  totalBaseAmount       Decimal                   @default(0) @db.Decimal(14, 2)
  averageRate           Decimal                   @default(0) @db.Decimal(6, 4)
  totalCommissionAmount Decimal                   @default(0) @db.Decimal(14, 2)
  status                CommissionStatementStatus @default(draft)
  pdfPath               String?
  xlsxPath              String?
  approvedByUserId      String?
  approvedAt            DateTime?
  paidAt                DateTime?
  supersededBy          String?
  notes                 String?
  items                 CommissionStatementItem[]
  // C-01: a PARTIAL unique index on (partnerId, periodFrom, periodTo) WHERE
  // supersededBy IS NULL enforces "at most one live statement per period" while
  // allowing superseded history. Prisma can't express partial indexes, so it
  // lives in migration 20260614000000_commission_statement_partial_unique.

  @@index([partnerId, periodFrom, periodTo])
  @@index([status])
}

model CommissionStatementItem {
  id               String                @id @default(cuid())
  statementId      String
  statement        CommissionStatement   @relation(fields: [statementId], references: [id])
  orderId          String?
  order            Order?                @relation(fields: [orderId], references: [id])
  paymentId        String?
  payment          Payment?              @relation(fields: [paymentId], references: [id])
  correctionId     String?
  correction       CommissionCorrection? @relation(fields: [correctionId], references: [id])
  orderNumber      String?
  organizationName String
  baseAmount       Decimal               @db.Decimal(14, 2)
  rate             Decimal               @db.Decimal(6, 4)
  commissionAmount Decimal               @db.Decimal(14, 2)

  @@index([statementId])
  @@index([orderId])
  @@index([paymentId])
  @@index([correctionId])
}

model CommissionCorrection {
  id                   String                    @id @default(cuid())
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  partnerId            String
  partner              Partner                   @relation(fields: [partnerId], references: [id])
  paymentId            String?                   @unique
  payment              Payment?                  @relation(fields: [paymentId], references: [id])
  originalStatementId  String?
  originalPeriodFrom   DateTime
  originalPeriodTo     DateTime
  amount               Decimal                   @db.Decimal(14, 2)
  rate                 Decimal                   @db.Decimal(6, 4)
  commissionAmount     Decimal                   @db.Decimal(14, 2)
  status               String                    @default("needs_review")
  reason               String?
  resolvedByUserId     String?
  resolvedAt           DateTime?
  parentCorrectionId   String?
  carriedReason        String?
  appliedInStatementId String?
  items                CommissionStatementItem[]

  @@index([partnerId, status])
  @@index([status, createdAt])
}

model Payment {
  id                   String                    @id @default(cuid())
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  organizationId       String
  organization         Organization              @relation(fields: [organizationId], references: [id])
  orderId              String?
  order                Order?                    @relation(fields: [orderId], references: [id])
  externalId           String?                   @unique
  amount               Decimal                   @db.Decimal(14, 2)
  paidAt               DateTime
  method               String?
  isRefund             Boolean                   @default(false)
  note                 String?
  vatAmount            Decimal?                  @db.Decimal(14, 2) // НДС (§7.1); null = не выделен
  purpose              String? // назначение платежа (§7.1; дублирует семантику note)
  paymentOrderNumber   String? // № платёжного поручения (§7.1)
  enteredById          String? // кто внёс платёж (§7.1)
  enteredBy            User?                     @relation("PaymentEnteredBy", fields: [enteredById], references: [id])
  commissionItems      CommissionStatementItem[]
  commissionCorrection CommissionCorrection?

  @@index([orderId])
  @@index([organizationId])
  @@index([paidAt])
  @@index([externalId])
}

model SavedView {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation("SavedViewOwner", fields: [userId], references: [id])
  scope     String
  name      String
  filters   Json
  isDefault Boolean  @default(false)
  isShared  Boolean  @default(false)

  @@index([userId, scope])
}

model SyncLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  entity       String
  externalId   String?
  direction    String
  operation    String
  status       String
  errorMessage String?
  payload      Json?
  durationMs   Int?

  @@index([entity, createdAt])
  @@index([status, createdAt])
}

model SyncState {
  entity        String    @id
  cursor        String?
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt
}

model OneCPendingRecord {
  id          String   @id @default(cuid())
  entity      String // 'organization' | 'order' | 'payment' | 'document'
  externalId  String
  dto         Json // raw 1C DTO, replayed verbatim through the idempotent writer
  reason      String // last transient skip reason
  attempts    Int      @default(0)
  status      String   @default("pending") // 'pending' | 'dead'
  firstSeenAt DateTime @default(now())
  lastTriedAt DateTime @updatedAt

  @@unique([entity, externalId])
  @@index([status, entity])
}

model SyncSchedulePause {
  schedulerId String   @id
  pausedAt    DateTime @default(now())
  pausedBy    String
}

model Partner {
  id                    String                 @id @default(cuid())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  name                  String
  legalName             String?
  slug                  String?                @unique
  inn                   String?                @unique
  commissionRate        Decimal                @default(0) @db.Decimal(6, 4)
  isActive              Boolean                @default(true)
  organizations         Organization[]
  users                 User[]
  orders                Order[]
  partnerUsers          PartnerUser[]
  leads                 Lead[]
  clientRequests        ClientRequest[]
  commissionStatements  CommissionStatement[]
  notifications         Notification[]
  enrollmentRequests    EnrollmentRequest[]
  commissionRateChanges CommissionRateChange[]
  commissionCorrections CommissionCorrection[]
}

/// История изменений ставки комиссии партнёра (§9.1). Append-only.
/// Используется расчётчиком (rateResolve.ts) для определения ставки на дату платежа
/// (A5, §9.2). Partner.commissionRate служит fallback-ом при пустой истории.
model CommissionRateChange {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  partnerId     String
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  oldRate       Decimal? @db.Decimal(6, 4) // null = первичная установка
  newRate       Decimal  @db.Decimal(6, 4)
  effectiveFrom DateTime @default(now()) // дата вступления (= момент изменения)
  changedById   String? // кто изменил (nullable для системных)

  @@index([partnerId, effectiveFrom])
}

/// F4 (§16, A5): история индивидуальной ставки организации. Append-only, по
/// образцу CommissionRateChange. resolveEffectiveRate резолвит по ней
/// org-override, действовавший на дату платежа (воспроизводимость расчёта при
/// изменении договорной ставки задним числом). Отличие от партнёрской истории:
/// newRate nullable — null = событие «очистка» (возврат к наследованию уровня
/// партнёра); oldRate null = до этой смены ставка не была задана.
model OrganizationCommissionRateChange {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oldRate        Decimal?     @db.Decimal(6, 4)
  newRate        Decimal?     @db.Decimal(6, 4)
  effectiveFrom  DateTime     @default(now())
  changedById    String?

  // Явное map: дефолтное имя превысило бы 63-байтовый лимит идентификатора PG.
  @@index([organizationId, effectiveFrom], map: "OrgCommissionRateChange_organizationId_effectiveFrom_idx")
}

model Organization {
  id                             String                             @id @default(cuid())
  createdAt                      DateTime                           @default(now())
  updatedAt                      DateTime                           @updatedAt
  name                           String
  externalId                     String?                            @unique
  inn                            String?                            @unique
  kpp                            String?
  partnerId                      String?
  partner                        Partner?                           @relation(fields: [partnerId], references: [id])
  companyId                      String?
  company                        Company?                           @relation(fields: [companyId], references: [id])
  assignedManagerUserId          String?
  partnerCommissionRate          Decimal?                           @db.Decimal(6, 4)
  partnerCommissionRateNote      String?
  partnerCommissionRateChangedAt DateTime?
  partnerCommissionRateChangedBy String?
  students                       Student[]
  users                          User[]                             @relation("UserOrganization")
  organizationUsers              OrganizationUser[]
  managers                       OrganizationManager[]              @relation("OrganizationManagers")
  notifications                  Notification[]
  leads                          Lead[]
  clientRequests                 ClientRequest[]
  deals                          Deal[]                             @relation("OrganizationDeals")
  orders                         Order[]                            @relation("OrderOrganization")
  payments                       Payment[]
  enrollmentRequests             EnrollmentRequest[]
  certificates                   Certificate[]
  commissionRateChanges          OrganizationCommissionRateChange[]
  tasks                          Task[]                             @relation("TaskLinkedOrganization")
  calendarEvents                 CalendarEvent[]                    @relation("CalendarEventLinkedOrganization")
  inboundMessages                InboundMessage[]                   @relation("OrgInbound")
  calls                          Call[]                             @relation("OrgCalls")
  contacts                       Contact[]                          @relation("OrgContacts")

  @@index([partnerId])
  @@index([externalId])
  // F2 (§16): C8 company-wide org scope filters `where { companyId }`
  // (managerPolicy.managerOrgScope → manager/organizations listOrganizations,
  // manager/finance overview). companyId had no index at all.
  @@index([companyId])
}

model OrganizationUser {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  roleInOrg      String?
  isActive       Boolean      @default(true)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, isActive])
}

model OrganizationManager {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation("OrganizationManagers", fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserManagedOrgs", fields: [userId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true)
  assignedAt     DateTime     @default(now())
  assignedBy     String?
  deactivatedAt  DateTime?

  @@unique([organizationId, userId])
  @@index([userId, isActive])
}

model Student {
  id                String                  @id @default(cuid())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  email             String
  name              String
  status            String                  @default("active")
  organizationId    String
  organization      Organization            @relation(fields: [organizationId], references: [id])
  externalStudentId String?
  orderItems        OrderItem[]
  certificates      Certificate[]
  enrollmentItems   EnrollmentRequestItem[]

  @@unique([organizationId, email])
}

model Company {
  id                    String              @id @default(cuid())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  name                  String
  managerTeamVisibility Boolean             @default(false)
  users                 User[]
  orders                Order[]
  organizations         Organization[]
  documents             Document[]
  accessProfiles        AccessProfile[]
  funnelStages          FunnelStage[]
  deals                 Deal[]              @relation("CompanyDeals")
  dealStages            DealStage[]         @relation("CompanyDealStages")
  taskColumns           TaskColumn[]
  tasks                 Task[]
  inboundMessages       InboundMessage[]
  calls                 Call[]
  contacts              Contact[]           @relation("CompanyContacts")
  salesTargets          SalesTarget[]
  staffConversations    StaffConversation[]
  calendarEvents        CalendarEvent[]
}

// Трек G1 (§3.2 ТЗ): роль-профиль как данные. Матрица охватов по типам объектов
// + capability-флаги (default-deny, open-ended String[]). Привязан к компании
// (граница изоляции C8). Действует поверх системного enum Role, внутри
// менеджерского контура; @@unique([companyId, name]) — имя уникально в компании.
model AccessProfile {
  id                 String     @id @default(cuid())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  companyId          String
  company            Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  ordersScope        ScopeLevel @default(all)
  organizationsScope ScopeLevel @default(all)
  threadsScope       ScopeLevel @default(all)
  documentsScope     ScopeLevel @default(all)
  financeScope       ScopeLevel @default(all)
  leadsScope         ScopeLevel @default(all)
  tasksScope         ScopeLevel @default(all)
  capabilities       String[]
  users              User[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Трек G2 (§24.3 ТЗ): настраиваемые стадии воронки продаж — словарь поверх
// enum-якорей LeadStatus. Company-scoped (руководитель конфигурирует). Пустой
// набор у компании → используются DEFAULT_FUNNEL_STAGES (код). statusAnchor
// связывает стадию с lifecycle-переходом лида; несколько стадий могут делить
// один якорь (напр. «Предложение» и «Оплата» под qualified).
// Этап 6 (Модуль 4, ФТ-4.1): сделка — внутренняя сущность продаж (клиентские
// роли её не видят). Не путать с /partner/deals (портфолио ЗАКАЗОВ клиента).
model Deal {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  companyId       String
  company         Company       @relation("CompanyDeals", fields: [companyId], references: [id], onDelete: Cascade)
  leadId          String?       @unique
  lead            Lead?         @relation("DealFromLead", fields: [leadId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization? @relation("OrganizationDeals", fields: [organizationId], references: [id], onDelete: SetNull)
  contactId       String?
  title           String
  amount          Decimal?      @db.Decimal(14, 2)
  managerId       String?
  manager         User?         @relation("DealManager", fields: [managerId], references: [id], onDelete: SetNull)
  status          DealStatus    @default(open)
  // null → дефолтная стадия для текущего status-якоря (как Lead.funnelStageId).
  stageId         String?
  stage           DealStage?    @relation("DealStageDeals", fields: [stageId], references: [id], onDelete: SetNull)
  expectedCloseAt DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  lostReason      String?
  // Заказ, созданный при выигрыше (PR-2); externalId у него null — 1С-синк не трогает.
  orderId         String?       @unique
  order           Order?        @relation("DealOrder", fields: [orderId], references: [id], onDelete: SetNull)
  notes           DealNote[]    @relation("DealNotes")

  @@index([companyId, status])
  @@index([managerId])
  @@index([stageId])
}

// Этап 6 (ФТ-4.2): словарь стадий сделок — зеркало FunnelStage.
model DealStage {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  companyId    String
  company      Company    @relation("CompanyDealStages", fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  position     Int
  statusAnchor DealStatus
  color        String?
  isTerminal   Boolean    @default(false)
  deals        Deal[]     @relation("DealStageDeals")

  @@unique([companyId, position])
  @@index([companyId])
}

model FunnelStage {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  position     Int
  statusAnchor LeadStatus
  color        String?
  isTerminal   Boolean    @default(false)
  leads        Lead[]     @relation("LeadFunnelStage")

  @@unique([companyId, position])
  @@index([companyId])
}

// Трек G3 (§21): настраиваемые колонки канбана задач — словарь поверх enum-якорей
// TaskStatus. Company-scoped (руководитель конфигурирует). Пустой набор у компании →
// используются DEFAULT_TASK_COLUMNS (код). statusAnchor связывает колонку со статусом
// задачи; isDoneColumn → moveTask проставляет completedAt. Зеркало FunnelStage.
model TaskColumn {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  position     Int
  statusAnchor TaskStatus
  color        String?
  isDoneColumn Boolean    @default(false)
  tasks        Task[]     @relation("TaskColumnTasks")

  @@unique([companyId, position])
  @@index([companyId])
}

// Трек G3 (§21, §13.3): внутренняя задача (сотрудники: admin/leader/manager).
// Company-scoped (hard FK, граница изоляции C8). columnId — soft-link (SetNull:
// удаление колонки не удаляет задачу — колонка re-derive из status-якоря).
// Привязки к заявке/организации — nullable SetNull. Клиентский контур задач не видит.
model Task {
  id                   String         @id @default(cuid())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  companyId            String
  company              Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title                String
  description          String?
  status               TaskStatus     @default(todo)
  priority             TaskPriority?
  columnId             String?
  column               TaskColumn?    @relation("TaskColumnTasks", fields: [columnId], references: [id], onDelete: SetNull)
  dueDate              DateTime?
  completedAt          DateTime?
  createdById          String
  createdBy            User           @relation("TaskCreatedBy", fields: [createdById], references: [id])
  linkedOrderId        String?
  linkedOrder          Order?         @relation("TaskLinkedOrder", fields: [linkedOrderId], references: [id], onDelete: SetNull)
  linkedOrganizationId String?
  linkedOrganization   Organization?  @relation("TaskLinkedOrganization", fields: [linkedOrganizationId], references: [id], onDelete: SetNull)
  assignees            TaskAssignee[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([linkedOrderId])
  @@index([linkedOrganizationId])
}

// M:N исполнители задачи (идиома репозитория — OrganizationUser/PartnerUser).
model TaskAssignee {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("TaskAssignee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model Order {
  id                 String                    @id @default(cuid())
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  externalId         String?                   @unique
  orderNumber        String?
  title              String
  status             OrderStatus               @default(new)
  executionStatus    ExecutionStatus           @default(pending)
  financialStatus    FinancialStatus           @default(not_billed)
  totalAmount        Decimal                   @default(0) @db.Decimal(14, 2)
  paidAmount         Decimal                   @default(0) @db.Decimal(14, 2)
  paidAt             DateTime?
  contractSignedAt   DateTime?
  completedAt        DateTime?
  closedAt           DateTime?
  lastSyncedAt       DateTime?
  vatIncluded        Boolean                   @default(true)
  vatRate            Decimal?                  @db.Decimal(5, 4)
  productMix         String[]
  serviceType        ServiceType               @default(training)
  // §5.6/§21: «галочка» менеджера «бухгалтерия подписана» — условие завершения (B2).
  accountingSignedAt DateTime?
  // §5.4: причина возврата на доработку, пока status=waiting_client (B3). Чистится при возврате в работу.
  returnReason       String?
  deadline           DateTime?
  companyId          String
  company            Company                   @relation(fields: [companyId], references: [id])
  partnerId          String?
  partner            Partner?                  @relation(fields: [partnerId], references: [id])
  organizationId     String
  organization       Organization              @relation("OrderOrganization", fields: [organizationId], references: [id])
  managerId          String?
  manager            User?                     @relation("OrderManager", fields: [managerId], references: [id])
  documents          Document[]
  comments           Comment[]
  uploads            Upload[]
  payments           Payment[]
  promotedFromLead   Lead?                     @relation("LeadPromoted")
  commissionItems    CommissionStatementItem[]
  threads            OrderThread[]
  items              OrderItem[]
  tasks              Task[]                    @relation("TaskLinkedOrder")
  dealNotes          DealNote[]                @relation("OrderDealNotes")
  wonDeal            Deal?                     @relation("DealOrder")
  calendarEvents     CalendarEvent[]           @relation("CalendarEventLinkedOrder")
  primaryContactId   String?
  primaryContact     Contact?                  @relation("OrderPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  @@index([partnerId, executionStatus])
  @@index([partnerId, financialStatus])
  @@index([organizationId, executionStatus])
  @@index([organizationId, financialStatus])
  @@index([externalId])
  @@index([closedAt])
  @@index([managerId, executionStatus])
  // F2 (§16): C8 company-wide manager scope filters `where { companyId, … }`
  // (managerPolicy.companyWideOrderFilter → manager/orders listOrders,
  // leader/dashboard groupBy activeWhere, manager/dashboard KPIs). No index
  // led with companyId existed — every company-wide list was a seq scan.
  @@index([companyId, executionStatus])
  @@index([companyId, financialStatus])
}

model Document {
  id                 String             @id @default(cuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  name               String
  path               String
  mimeType           String
  size               Int?
  type               DocumentType       @default(other)
  direction          DocumentDirection  @default(incoming)
  version            Int                @default(1)
  replacesDocumentId String?
  signedAt           DateTime?
  generatedBy        GenerationSource   @default(user)
  externalId         String?            @unique
  orderId            String?
  order              Order?             @relation(fields: [orderId], references: [id])
  companyId          String?
  // Restrict (not SetNull): an order-less doc with companyId nulled would
  // violate the XOR CHECK below. Companies are not deleted in normal ops.
  company            Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  counterpartyType   CounterpartyType
  counterpartyId     String
  uploadedById       String?
  uploadedBy         User?              @relation(fields: [uploadedById], references: [id])
  scanStatus         String             @default("pending")
  scanReason         String?
  scannedAt          DateTime?
  viewMarks          DocumentViewMark[]

  @@index([orderId, type])
  @@index([counterpartyType, counterpartyId])
  @@index([type, createdAt])
  @@index([externalId])
  @@index([scanStatus])
  @@index([companyId])
}

/// Этап 3 PR-2 (ФТ-6.6): отметка «пользователь видел документ» — бейдж «новый»
/// в клиентских списках. Ставится при скачивании (download-роуты), one row per
/// (document, user) — образец ThreadReadState.
model DocumentViewMark {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  viewedAt   DateTime @default(now())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
}

model Comment {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  body           String
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  attachmentPath String?

  @@index([authorId, orderId])
}

model Upload {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  filename  String
  path      String
  size      Int
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  action    String
  entity    String
  entityId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  meta      Json?

  // F1 (§16): AuditLog had zero indexes → full seq scan on every filtered read.
  // Patterns from services: per-entity trail (manager/orderDetail.ts,
  // admin/commissionStatements.ts) → [entity, entityId]; actor filter + recency
  // sort (admin/auditLog.ts listAudit) → [userId, createdAt]; global recency feed
  // (admin/dashboard.ts recentEvents, listAudit default) → [createdAt].
  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// §25.7: журнал доступа сотрудников к ПДн физлиц клиентского контура.
/// Append-only: приложение никогда не обновляет и не удаляет строки.
/// subjectIds хранит id строк (Student.id, Call.id, ...), не сами ПДн;
/// meta НИКОГДА не содержит сырых поисковых строк (только hasQuery/take/cursor).
model PiiAccessEvent {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  userRole     String // снапшот на момент доступа: admin | manager | leader
  companyId    String? // снапшот C8-скоупа сессии
  context      String // ключ PII_CONTEXTS (src/lib/pii/contexts.ts)
  action       String // list | view
  subjectType  String // student | lead | enrollment_request | user | caller | inbound_sender
  subjectIds   String[] // точный поимённый состав выдачи (естественный cap: take<=100)
  subjectCount Int // = subjectIds.length (денорм для сводок)
  meta         Json?

  @@index([subjectIds], type: Gin) // обратный поиск «кто смотрел субъекта X»
  @@index([userId, createdAt]) // трейл по сотруднику
  @@index([subjectType, createdAt])
  @@index([createdAt])
}

model Notification {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  partnerId      String?
  partner        Partner?      @relation(fields: [partnerId], references: [id])
  type           String
  title          String
  body           String
  isRead         Boolean       @default(false)
  meta           Json?

  // F2 (§16): the notification feed reads `where userId orderBy createdAt desc`
  // (api/notifications GET) and the unread badge counts `where userId, isRead`
  // (manager/dashboard/kpis). [userId, createdAt] serves the feed and subsumes
  // the old single-column [userId] (leading-prefix), which is dropped as
  // redundant; [userId, isRead] serves the unread count.
  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([organizationId])
  @@index([partnerId])
  @@index([createdAt])
}

model StudentBridgeGrant {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  code      String    @unique
  jti       String    @unique
  token     String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  purpose   String // "invite" | "reset"
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// Staff 2FA (спека 2026-07-11): одноразовый email-код при логине staff-ролей.
model TwoFactorChallenge {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String   @unique // одна активная challenge на пользователя (upsert)
  user      User     @relation(fields: [userId], references: [id])
  codeHash  String // sha256(code) — плейнтекст не хранится (§12)
  expiresAt DateTime
  attempts  Int      @default(0)

  @@index([expiresAt])
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String    @unique
  usedAt    DateTime?

  @@index([userId])
}

model StudentBridgeTokenJti {
  jti       String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  usedAt    DateTime

  @@index([expiresAt])
}

model AlertState {
  key            String    @id
  status         String // "firing" | "resolved"
  severity       String // "warning" | "critical"
  message        String
  value          Int?
  firstSeenAt    DateTime  @default(now())
  lastNotifiedAt DateTime  @default(now())
  resolvedAt     DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

model OrderThread {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  side            ThreadSide
  createdAt       DateTime          @default(now())
  lastMessageAt   DateTime          @default(now())
  messages        Message[]
  readStates      ThreadReadState[]
  inboundMessages InboundMessage[]

  @@unique([orderId, side])
  @@index([side, lastMessageAt])
}

model Message {
  id             String      @id @default(cuid())
  threadId       String
  thread         OrderThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId       String
  author         User        @relation("MessageAuthor", fields: [authorId], references: [id])
  body           String
  attachmentPath String?
  createdAt      DateTime    @default(now())

  @@index([threadId, createdAt])
}

model ThreadReadState {
  id         String      @id @default(cuid())
  threadId   String
  thread     OrderThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime    @default(now())

  @@unique([threadId, userId])
}

enum EnrollmentStatus {
  pending
  approved
  rejected
  provisioned
  // Этап 2 (Модуль 2): продолжение конвейера после зачисления. Русские подписи
  // ленты: «подана → принята → зачислены → идёт обучение → удостоверения готовы».
  in_training
  certificates_ready
}

enum TrainingStatus {
  pending
  in_progress
  certificate_issued
  cancelled
}

// T5 → Этап 2 (Модуль 2): «заявка на обучение» — шапка (податель, направление,
// статус) + позиции EnrollmentRequestItem (слушатели). Направление — только из
// справочника TrainingDirection (у legacy-заявок остаётся текст в legacyCourseTitle,
// directionId NULL; при создании directionId обязателен — валидирует сервис).
// Provisioning остаётся ручным (внешняя LMS); externalStudentId живёт на позиции.
model EnrollmentRequest {
  id                String                  @id @default(cuid())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  submittedByUserId String
  submittedByUser   User                    @relation("EnrollmentSubmitter", fields: [submittedByUserId], references: [id])
  submitterRole     String
  partnerId         String?
  partner           Partner?                @relation(fields: [partnerId], references: [id])
  organizationId    String?
  organization      Organization?           @relation(fields: [organizationId], references: [id])
  directionId       String?
  direction         TrainingDirection?      @relation(fields: [directionId], references: [id])
  legacyCourseTitle String?
  note              String?
  status            EnrollmentStatus        @default(pending)
  reviewedByUserId  String?
  reviewedByUser    User?                   @relation("EnrollmentReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  rejectedReason    String?
  provisionedAt     DateTime?
  items             EnrollmentRequestItem[]

  @@index([status])
  @@index([partnerId])
  @@index([submittedByUserId])
  @@index([directionId])
}

// Позиция заявки на обучение: один слушатель — либо существующий Student
// (studentId + копия ФИО/email на момент подачи), либо новый (введён строкой /
// импортом). Доп. поля вопроса 5 ТЗ (должность, СНИЛС, дата рождения,
// «Дополнительно») — необязательные; Student ими не расширяется намеренно
// (данные относятся к конкретному обучению). Индивидуальный статус позиции
// движется по тому же конвейеру EnrollmentStatus.
model EnrollmentRequestItem {
  id                String            @id @default(cuid())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  requestId         String
  request           EnrollmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  studentId         String?
  student           Student?          @relation(fields: [studentId], references: [id])
  fullName          String
  email             String
  position          String?
  snils             String?
  birthDate         DateTime?
  extra             String?
  status            EnrollmentStatus  @default(pending)
  externalStudentId String?

  @@index([requestId])
  @@index([studentId])
}

model TrainingDirection {
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  name               String
  slug               String?             @unique
  isActive           Boolean             @default(true)
  sortOrder          Int                 @default(0)
  orderItems         OrderItem[]
  certificates       Certificate[]
  enrollmentRequests EnrollmentRequest[]

  @@index([isActive, sortOrder])
}

model OrderItem {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student           @relation(fields: [studentId], references: [id])
  directionId    String
  direction      TrainingDirection @relation(fields: [directionId], references: [id])
  trainingStatus TrainingStatus    @default(pending)
  note           String?
  certificate    Certificate?

  @@unique([orderId, studentId, directionId])
  @@index([orderId])
  @@index([studentId])
  @@index([directionId])
}

model Certificate {
  id             String                @id @default(cuid())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  studentId      String
  student        Student               @relation(fields: [studentId], references: [id])
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id])
  directionId    String
  direction      TrainingDirection     @relation(fields: [directionId], references: [id])
  orderItemId    String?               @unique
  orderItem      OrderItem?            @relation(fields: [orderItemId], references: [id])
  number         String
  issuedAt       DateTime
  validUntil     DateTime?
  documentId     String?
  source         GenerationSource      @default(user)
  comment        String?
  reminders      CertificateReminder[]

  @@index([studentId])
  @@index([organizationId])
  @@index([validUntil])
  @@index([directionId])
}

model CertificateReminder {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  thresholdDays Int
  sentAt        DateTime    @default(now())

  @@unique([certificateId, thresholdDays])
}

enum CustomFieldType {
  text
  number
  date
  select
  boolean
}

/// §11: настраиваемое (доп.) поле сущности. Конфигурит admin. Полиморфно по entityType (v1='order').
model CustomFieldDefinition {
  id         String             @id @default(cuid())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  entityType String
  key        String
  label      String
  fieldType  CustomFieldType
  options    String[]
  required   Boolean            @default(false)
  sortOrder  Int                @default(0)
  isActive   Boolean            @default(true)
  values     CustomFieldValue[]

  @@unique([entityType, key])
  @@index([entityType, isActive, sortOrder])
}

/// §11: значение настраиваемого поля у конкретной записи (полиморфно: entityType+entityId).
model CustomFieldValue {
  id           String                @id @default(cuid())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  entityType   String
  entityId     String
  value        String?

  @@unique([definitionId, entityId])
  @@index([entityType, entityId])
}

model PaymentImportBatch {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())
  importedById String?
  importedBy   User?              @relation("PaymentImportBatchBy", fields: [importedById], references: [id])
  companyId    String?
  fileKey      String?
  fileName     String
  counts       Json
  status       String
  rows         PaymentImportRow[]

  @@index([companyId, createdAt])
}

model PaymentImportRow {
  id                 String             @id @default(cuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  batchId            String
  batch              PaymentImportBatch @relation(fields: [batchId], references: [id])
  externalId         String             @unique
  paidAt             DateTime
  amount             Decimal            @db.Decimal(14, 2)
  isRefund           Boolean            @default(false)
  purpose            String?
  paymentOrderNumber String?
  vatAmount          Decimal?           @db.Decimal(14, 2)
  counterpartyName   String?
  counterpartyInn    String?
  accountCandidates  Json
  status             String             @default("needs_review")
  candidateOrgId     String?
  candidateOrderId   String?
  matchMethod        String?
  rawRow             Json
  resolvedPaymentId  String?

  @@index([status, createdAt])
  @@index([batchId])
}

model InboundMessage {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  channel        String
  externalId     String    @unique
  senderRef      String
  senderDisplay  String?
  subject        String?
  body           String
  attachmentPath String?
  attachmentName String?
  attachmentMime String?
  scanStatus     String    @default("none")
  scanReason     String?
  resolvedOrgId  String?
  resolvedUserId String?
  threadId       String?
  companyId      String?
  status         String    @default("unresolved")
  boundAt        DateTime?
  boundById      String?
  contactId      String?

  resolvedOrg  Organization? @relation("OrgInbound", fields: [resolvedOrgId], references: [id])
  resolvedUser User?         @relation("UserInbound", fields: [resolvedUserId], references: [id])
  thread       OrderThread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)
  company      Company?      @relation(fields: [companyId], references: [id])
  contact      Contact?      @relation("ContactInbound", fields: [contactId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([companyId, createdAt])
  @@index([resolvedOrgId, createdAt])
  @@index([channel, createdAt])
  @@index([threadId])
}

// PR-B: телефония Mango — журнал звонков (входящих/исходящих).
model Call {
  id                  String    @id @default(cuid())
  createdAt           DateTime  @default(now())
  provider            String    @default("mango")
  externalId          String
  direction           String
  callerNumber        String
  internalNumber      String?
  startedAt           DateTime?
  answeredAt          DateTime?
  finishedAt          DateTime?
  durationSec         Int?
  status              String
  recordingId         String?
  recordingPath       String?
  recordingScanStatus String    @default("none")
  resolvedOrgId       String?
  resolvedUserId      String?
  initiatedByUserId   String?
  initiatedBy         User?     @relation("CallInitiator", fields: [initiatedByUserId], references: [id])
  threadId            String?
  companyId           String?
  contactId           String?

  resolvedOrg  Organization? @relation("OrgCalls", fields: [resolvedOrgId], references: [id])
  resolvedUser User?         @relation("UserCalls", fields: [resolvedUserId], references: [id])
  company      Company?      @relation(fields: [companyId], references: [id])
  contact      Contact?      @relation("ContactCalls", fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([companyId, createdAt])
  @@index([resolvedOrgId, createdAt])
  @@index([callerNumber, createdAt])
  @@index([threadId])
}

/// M2 (спека контактов): первоклассная сущность контакта (физлицо), к которой
/// привязываются каналы связи (телефон/email/telegram/whatsapp/max), входящие
/// сообщения, звонки и заказ (primaryContact). companyId — граница C8-изоляции.
model Contact {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  companyId      String
  company        Company       @relation("CompanyContacts", fields: [companyId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation("OrgContacts", fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?       @unique
  user           User?         @relation("UserContact", fields: [userId], references: [id], onDelete: SetNull)
  name           String
  position       String?
  note           String?
  isArchived     Boolean       @default(false)
  createdById    String?
  createdBy      User?         @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  channels        ContactChannel[]
  inboundMessages InboundMessage[] @relation("ContactInbound")
  calls           Call[]           @relation("ContactCalls")
  ordersAsPrimary Order[]          @relation("OrderPrimaryContact")

  @@index([companyId, organizationId])
  @@index([organizationId])
}

/// M2: канал связи контакта (телефон/email/мессенджер). Уникальность
/// нормализованного значения — per-company (§: разные компании могут иметь
/// клиентов с одним и тем же номером/email независимо друг от друга).
model ContactChannel {
  id              String             @id @default(cuid())
  createdAt       DateTime           @default(now())
  contactId       String
  contact         Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId       String
  type            ContactChannelType
  value           String
  normalizedValue String
  isPrimary       Boolean            @default(false)

  @@unique([companyId, type, normalizedValue])
  @@index([type, normalizedValue])
  @@index([contactId])
}

/// M1 (спека 2026-07-14): внутренняя заметка по сделке (staff-only). Отдельная
/// таблица, а не флаг на Comment — у заметки НЕТ клиентского пути чтения, поэтому
/// «клиент не видит» держится конструкцией (CLAUDE.md §5). Company-scope — через order.
model DealNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Этап 6 (решение §10-1 ТЗ): параллельная привязка — хотя бы одна из ссылок
  // (orderId | dealId) обязана быть заполнена (инвариант сервиса). SetNull вместо
  // Cascade: удаление заказа не должно уносить заметку, живущую и на сделке.
  orderId   String?
  order     Order?   @relation("OrderDealNotes", fields: [orderId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation("DealNotes", fields: [dealId], references: [id], onDelete: SetNull)
  authorId  String
  author    User     @relation("DealNoteAuthor", fields: [authorId], references: [id])
  body      String

  @@index([orderId, createdAt])
  @@index([authorId])
}

/// M3: месячный план продаж менеджера (деньги, нетто-оплаты). Задаёт руководитель.
/// Company-scoped (C8). Очистка плана = удаление строки (нет "нулевых" планов).
model SalesTarget {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managerId    String
  manager      User     @relation("SalesTargetManager", fields: [managerId], references: [id], onDelete: Cascade)
  year         Int
  month        Int // 1..12
  targetAmount Decimal  @db.Decimal(14, 2)
  createdById  String? // кто задал (аудит-денорм; полный трейл в AuditLog)

  @@unique([companyId, managerId, year, month])
  @@index([companyId, year, month])
}

/// M4 (спека 2026-07-17): внутренний чат сотрудников — ОТДЕЛЬНЫЙ домен от клиентского
/// чата (OrderThread): несовместимые модели видимости (§4 sibling-rule). dm: ровно 2
/// StaffParticipant; general: участников-строк нет (членство = все staff компании + admin,
/// Model A). dmKey = отсортированная пара "userAId:userBId" — «один ЛС на пару» держится
/// констрейнтом БД, не кодом (класс гонок C-01). «Один general на компанию» — партиальный
/// unique-индекс в миграции (Prisma его не выражает; прецедент C-01).
model StaffConversation {
  id            String                @id @default(cuid())
  createdAt     DateTime              @default(now())
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind          StaffConversationKind
  dmKey         String?               @unique
  lastMessageAt DateTime              @default(now())
  participants  StaffParticipant[]
  messages      StaffMessage[]
  readStates    StaffMessageRead[]

  @@index([companyId, lastMessageAt])
}

model StaffParticipant {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now())
  conversationId String
  conversation   StaffConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation("StaffChatParticipant", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model StaffMessage {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now())
  conversationId String
  conversation   StaffConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User              @relation("StaffMessageAuthor", fields: [authorId], references: [id])
  body           String
  attachmentPath String?
  attachmentName String?
  attachmentMime String?
  scanStatus     String            @default("none") // none|pending|clean|infected|error

  reactions StaffReaction[]

  @@index([conversationId, createdAt])
}

model StaffMessageRead {
  id             String            @id @default(cuid())
  conversationId String
  conversation   StaffConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation("StaffChatReadState", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime          @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model StaffReaction {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  messageId String
  message   StaffMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("StaffReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  @@unique([messageId, userId, emoji])
}

/// M5 (спека 2026-07-17): событие staff-календаря. Company-scoped (hard FK, C8).
/// Привязки к заявке/организации — nullable SetNull (идиома Task). Напоминание:
/// remindAt вычисляется сервисом (startsAt − remindMinutes) и «сжигается»
/// атомарным claim'ом reminderSentAt в процессоре (идемпотентность при retry).
model CalendarEvent {
  id                   String                  @id @default(cuid())
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  companyId            String
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title                String
  description          String?
  location             String?
  startsAt             DateTime
  endsAt               DateTime?
  allDay               Boolean                 @default(false)
  remindAt             DateTime?
  reminderSentAt       DateTime?
  createdById          String
  createdBy            User                    @relation("CalendarEventCreatedBy", fields: [createdById], references: [id])
  linkedOrderId        String?
  linkedOrder          Order?                  @relation("CalendarEventLinkedOrder", fields: [linkedOrderId], references: [id], onDelete: SetNull)
  linkedOrganizationId String?
  linkedOrganization   Organization?           @relation("CalendarEventLinkedOrganization", fields: [linkedOrganizationId], references: [id], onDelete: SetNull)
  attendees            CalendarEventAttendee[]

  @@index([companyId, startsAt])
  @@index([remindAt])
}

// M:N участники события (идиома репозитория — TaskAssignee).
model CalendarEventAttendee {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("CalendarEventAttendee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

/// Настройки интеграций, редактируемые админом в UI (телефония, мессенджеры,
/// почта). Заменяют env-конфиг: сервис читает БД, при отсутствии ключа —
/// fallback на process.env. Секретные значения (isSecret=true) хранятся
/// зашифрованными (AES-256-GCM, ключ APP_ENCRYPTION_KEY из env); несекретные —
/// открытым текстом. key — стабильный идентификатор вида 'email.resendApiKey'.
model IntegrationSetting {
  key       String   @id
  value     String?
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

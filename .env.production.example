# Шаблон production-окружения (топология C). Скопировать в .env.production и
# заполнить реальными значениями. .env.production НЕ коммитится (см. .gitignore).

# --- БД (managed PostgreSQL, РФ) ---
DATABASE_URL=postgresql://USER:PASS@managed-pg-host:5432/cabinet
DIRECT_URL=postgresql://USER:PASS@managed-pg-host:5432/cabinet

# --- Приложение ---
# Домен, на который Caddy выпускает TLS-сертификат (см. Caddyfile, SP3).
APP_DOMAIN=lk.example.ru
# Серверный base-URL (письма, приглашения, reset-ссылки, issuer student-bridge).
# ОБЯЗАТЕЛЕН (fail-fast на старте) и ДОЛЖЕН быть https://<APP_DOMAIN>;
# без него сработал бы hardcode-fallback https://lk.otsfera.ru.
# (NEXT_PUBLIC_APP_URL удалена 2026-07-10: ни одной точки чтения в src/ —
#  абсолютные URL строятся только из APP_URL.)
APP_URL=https://lk.example.ru
JWT_SECRET=replace_with_at_least_32_chars
HEALTH_TOKEN=replace_with_at_least_32_chars
# У-132: мастер-ключ секретов интеграций (AES-256-GCM). Без него ни один
# секрет, введённый в интерфейсе, сохранить нельзя, и сервер не поднимется.
# Формат: 64 hex-символа (ровно 32 байта) либо парольная фраза от 16 символов.
APP_ENCRYPTION_KEY=replace_me_64_hex_chars

# --- Наблюдаемость ---
# Sentry: пустой/незаданный DSN => полный no-op. Server/edge/worker.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Структурные логи: в production pino-JSON по умолчанию; уровень default info.
# LOG_LEVEL=info

# --- Redis (внутри compose-сети) ---
REDIS_URL=redis://redis:6379

# --- S3-совместимое хранилище (внешний РФ-бакет, SP1) ---
S3_ENDPOINT=https://s3.provider.ru
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_BUCKET=documents
S3_FORCE_PATH_STYLE=1

# --- Email (Resend): задаётся в интерфейсе (Настройки → Интеграции);
# --- env — запасной вариант, пока значения не сохранили из UI ---
EMAIL_ENABLED=true
RESEND_API_KEY=re_replace_me
EMAIL_FROM=no-reply@example.ru

# --- Worker cron + алерты ---
ENABLE_SYNC_CRON=1
# Грейс graceful shutdown воркера, мс (default 25000 < 30с grace Docker/K8s):
# WORKER_SHUTDOWN_TIMEOUT_MS=25000
# Канал ops-оповещений: задаётся в интерфейсе (Настройки → Безопасность и
# система → Здоровье системы → Оповещения); env — запасной вариант:
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=

# --- 1С: безопасный дефолт (живых записей нет до репетиции, launch-runbook §4).
# --- Адаптер и параметры задаются в интерфейсе (Настройки → Интеграции →
# --- Обмен с 1С); env — запасной вариант ---
ONE_C_ADAPTER=fake

# --- Уведомления: Telegram-бот пользователей (опционально; фича дремлет без
# --- кредов); задаётся в интерфейсе (Настройки → Интеграции); env — запасной ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=replace_with_at_least_32_chars

# --- Student bridge (мост в внешнюю СДО; опционально до подключения СДО) ---
# Адрес учебной площадки и домены задаётся в интерфейсе (Настройки →
# Интеграции → «Учебная площадка», `У-274`); env — запасной:
# STUDENT_REDIRECT_URL=https://lms.example.com/auth/bridge
# STUDENT_REDIRECT_ALLOWED_DOMAINS=lms.example.com
# `У-323`: обязателен в production и НЕ равен JWT_SECRET — иначе токен,
# выданный учебной площадке, подписан ключом сессий ЛК.
STUDENT_BRIDGE_JWT_SECRET=replace_with_at_least_32_chars
# STUDENT_BRIDGE_SHARED_SECRET=replace_with_at_least_32_chars

# --- Антивирус ClamAV — сервис `clamav` в docker-compose.prod.yml (`У-322`).
# --- Без него в production скан отказывается помечать файл clean: документы
# --- остаются `pending` и не скачиваются ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Feature flags. С 23.09.2026 (прогон сопровождения №37) готовые функции,
# --- которым нужна только база (чат, контакты, автоматизация, центр
# --- уведомлений, задачи, календарь, поиск, воронка, конструктор ролей и др.),
# --- ВКЛЮЧЕНЫ по умолчанию — выставлять не нужно; `=0` — аварийный тормоз.
# --- Ниже — только opt-in флаги внешней неготовности (матрица:
# --- docs/feature-flags-matrix.md) ---
# Доставка уведомлений через воркер (Redis в контуре есть — рекомендовано):
# FEATURE_NOTIF_QUEUE=1
# Каналы Max/WhatsApp — только когда владелец подключил бота/агрегатор и внёс креды:
# FEATURE_MAX_CHANNEL=0
# FEATURE_WHATSAPP_CHANNEL=0
# Омниканальный инбокс: мессенджер-каналы готовы; секреты вебхуков и входящая
# почта (IMAP-адаптер боевой: ImapFlow, курсор UID) задаются в интерфейсе
# (Настройки → Интеграции); env — запасной вариант:
# FEATURE_INBOUND_MESSAGING=0
# «Задать вопрос» из кабинетов заказчика и партнёра — включать ТОЛЬКО вместе с
# FEATURE_INBOUND_MESSAGING: ответить на вопрос менеджер может лишь из «Мессенджеров».
# FEATURE_CABINET_QUESTIONS=0
# WHATSAPP_WEBHOOK_SECRET=replace_with_at_least_32_chars
# Телефония Mango: REST-адаптер записей — заглушка; держать 0 до его реализации.
# Ключи и allowlist задаются в интерфейсе (Настройки → Интеграции); env — запасной.
# При включении обязательны MANGO_API_KEY/MANGO_API_SALT (fail-fast):
# FEATURE_TELEPHONY_MANGO=0
# MANGO_API_KEY=
# MANGO_API_SALT=
# MANGO_ALLOWED_IPS=81.88.80.132,81.88.80.133,81.88.82.36

# 2FA сотрудников: email-код при логине admin/manager/leader (спека 2026-07-11).
# Включать после проверки доставки писем (EMAIL_ENABLED=true + RESEND_API_KEY):
# при сбое отправки логин сотрудника вернёт 502 и не пустит внутрь.
# FEATURE_STAFF_2FA=1

# FEATURE_PII_ACCESS_LOG=0        # Журнал доступа к ПДн (§25.7): opt-out, ВКЛЮЧЁН по умолчанию. 0 — только аварийный kill-switch на время инцидента

# --- НИКОГДА в проде: SHOW_DEMO_LOGINS (раскрытие демо-учёток) — не выставлять,
# --- fail-fast валидация окружения не даст стартовать (src/lib/env.ts) ---
